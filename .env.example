# ============================================================================
# Ospreyn environment variables
#
# Two separate deployments read from this file's variables:
#   - FRONTEND (Netlify): only the VITE_* variables. These are compiled into
#     the public JavaScript bundle, so never put a secret here.
#   - API (Render/Railway/Fly/Cloud Run): everything else. These are secrets
#     and must only ever be set on the API host.
#
# Copy to .env for local development. .env is gitignored; .env.example is not.
# ============================================================================


# ---------------------------------------------------------------------------
# FRONTEND — set these in Netlify > Site configuration > Environment variables
# ---------------------------------------------------------------------------

# Base URL of the Ospreyn API, with no trailing slash.
# Leave empty for local development, where Vite proxies /api to localhost:3000.
# Required in production: without it the bundle calls the Netlify CDN, which
# has no /api routes.
VITE_API_BASE_URL="https://api.your-ospreyn-domain.com"

# Local development only: where Vite proxies /api to. Defaults to localhost:3000.
# VITE_DEV_API_TARGET="http://localhost:3000"


# ---------------------------------------------------------------------------
# API — DATABASE (required)
# ---------------------------------------------------------------------------

# PostgreSQL 16+. Neon, Supabase, RDS and Railway all provide this string.
DATABASE_URL="postgresql://user:password@host:5432/ospreyn"

# Force TLS on/off. Defaults to on in production, off locally.
DATABASE_SSL="true"

# Maximum pooled connections. Keep below your provider's limit.
DATABASE_POOL_MAX="10"


# ---------------------------------------------------------------------------
# API — HTTP AND CORS (required in production)
# ---------------------------------------------------------------------------

# Injected by most hosts. Do not hardcode.
PORT="3000"

NODE_ENV="production"

# Where the frontend is served from. Used to build contributor review links
# and to decide cookie SameSite behaviour.
APP_ORIGIN="https://your-site.netlify.app"

# Public URL of this API. Used together with APP_ORIGIN to detect whether the
# deployment is cross-site.
API_ORIGIN="https://api.your-ospreyn-domain.com"

# Comma-separated browser origins allowed to call this API with credentials.
# Include your Netlify domain and any custom domain. Defaults to APP_ORIGIN.
CORS_ORIGINS="https://your-site.netlify.app,https://app.your-ospreyn-domain.com"

# Allow https://<hash>--<site>.netlify.app deploy previews. Set false to lock down.
ALLOW_NETLIFY_PREVIEWS="true"


# ---------------------------------------------------------------------------
# API — SESSIONS AND ACCESS
# ---------------------------------------------------------------------------

# Days before a signed-in session expires.
SESSION_TTL_DAYS="14"

# Days a contributor review link stays valid.
INVITATION_TTL_DAYS="7"

# Set to "none" to force cross-site cookies. Auto-detected from the origins above.
# COOKIE_SAMESITE="none"

# Only set if the API and frontend share a parent domain.
# COOKIE_DOMAIN=".your-ospreyn-domain.com"

# Set to "false" to close public sign-ups.
ALLOW_REGISTRATION="true"


# ---------------------------------------------------------------------------
# API — OBJECT STORAGE for the document vault (required for uploads)
# Works with AWS S3, Cloudflare R2, Backblaze B2 or MinIO.
# The bucket MUST be private; access is only ever through presigned URLs.
# ---------------------------------------------------------------------------

S3_BUCKET="ospreyn-documents"
S3_REGION="eu-west-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Required for R2, B2 and MinIO. Omit for AWS S3.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Path-style addressing. Defaults to true whenever S3_ENDPOINT is set.
# S3_FORCE_PATH_STYLE="true"

# Seconds a presigned upload/download URL stays valid.
S3_UPLOAD_URL_TTL="900"
S3_DOWNLOAD_URL_TTL="300"

# Set to "false" to disable server-side encryption (not recommended).
# S3_SSE="true"

# Largest accepted upload, in bytes. Default 50 MB.
MAX_UPLOAD_BYTES="52428800"


# ---------------------------------------------------------------------------
# API — FIRST-RUN BOOTSTRAP (optional)
# Used once by `npm run migrate` to create the first owner account.
# Remove BOOTSTRAP_PASSWORD from the environment once it has run.
# ---------------------------------------------------------------------------

# BOOTSTRAP_EMAIL="you@example.com"
# BOOTSTRAP_PASSWORD="a-long-password-at-least-12-chars"
# BOOTSTRAP_FULL_NAME="Your Legal Name"
# BOOTSTRAP_STAGE_NAME="Your Professional Name"
# BOOTSTRAP_ORG_NAME="Your Workspace"
